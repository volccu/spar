# Every setting spår reads, and where each one goes. Nothing here is required:
# with none of it set, the web app builds and runs on this device only, with
# no account, no sync and no reminders that ring.
#
# The root scripts (`npm run import`, `npm run search`, `npm run seed`) read
# no variables. The web build reads web/.env — copy web/.env.example there.
#
# --- Web build (web/.env) -----------------------------------------------------
# Baked into the bundle at build time, so all of them are public by nature.
#
# Your Supabase project's URL (Dashboard -> Project Settings -> API).
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Its publishable ("anon") key, from the same page. Row level security is what
# protects the data; this key only identifies the project.
# VITE_SUPABASE_ANON_KEY=your-publishable-key
# The public half of your Web Push (VAPID) key pair. Without it the app says
# reminders will not ring on this device. Must match VAPID_PUBLIC_KEY below.
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
#
# --- Edge function secrets (`supabase secrets set NAME=value`) ---------------
# Never put these in a file that is built or committed. `npm run supabase:setup`
# sets all five on a project of your own (docs/self-hosting.md, "Bring your own
# Supabase"), and stores CRON_SECRET in Vault for the reminder sweep as well.
#
# link-preview: the origins your app is served from, comma-separated. The local
# dev server (http://localhost:5173) is always allowed.
# ALLOWED_ORIGINS=https://notes.example.com
#
# send-reminders: the Web Push key pair (base64url) and a contact address.
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:you@example.com
# The shared secret pg_cron sends with each sweep (see migration 0015).
# CRON_SECRET=a-long-random-string
#
# --- The spår server (server/), read from its environment at start ----------
# Every one is optional; docs/server-api.md ("Server settings") says what each does.
# SPAR_DATA_DIR=/data                 # spar.db, files/, vapid.json, session-secret
# SPAR_HOST=127.0.0.1                 # 0.0.0.0 inside a container
# SPAR_PORT=8080
# SPAR_SIGNUP=closed                  # closed | invite | open; the first account is always allowed
# SPAR_STORAGE_CAP_MB=0               # file storage per account; 0 = no cap
# SPAR_ALLOWED_HOSTS=notes.example.com         # the Host names it answers to (recommended)
# SPAR_ALLOWED_ORIGINS=http://localhost:5173   # other origins given credentialed CORS
# SPAR_COOKIE_SECURE=auto             # auto | true | false
# SPAR_TRUST_PROXY=0                  # 1 behind a proxy that sets X-Forwarded-*
# SPAR_VAPID_SUBJECT=mailto:you@example.com
# SPAR_VAPID_PUBLIC_KEY=              # both, to reuse an existing pair instead of the generated one
# SPAR_VAPID_PRIVATE_KEY=
# SPAR_WEB_DIR=                       # serve the built app (web/dist) on the same port
# SPAR_SCRYPT_LOG_N=15
