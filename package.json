{
  "name": "spar",
  "description": "A local-first notes app: capture asks for nothing, organising is one gesture, and there is no AI.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volccu/spar.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "git pull --ff-only",
    "dev": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build:demo": "npm --prefix web run build:demo",
    "test:web": "npm --prefix web test",
    "test:e2e": "npm --prefix web run build:demo && npm --prefix web run test:e2e",
    "server": "tsx server/src/main.ts",
    "server:cli": "tsx server/src/cli.ts",
    "build:server": "node server/build.mjs",
    "typecheck:server": "tsc -p server",
    "typecheck:root": "tsc -p tsconfig.json",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test": "vitest run",
    "test:conformance": "vitest run --config conformance/vitest.config.ts",
    "test:conformance:server": "vitest run --config conformance/vitest.spar-server.config.ts",
    "e2e:server": "node scripts/e2e-spar-server.mjs",
    "shots": "node scripts/shots.mjs",
    "conformance:stack": "node scripts/conformance-stack.mjs",
    "test:watch": "vitest",
    "import": "tsx src/import.ts",
    "search": "tsx src/search.ts",
    "db:push": "supabase db push && npm run db:verify",
    "db:verify": "node scripts/verify-migrations.mjs",
    "db:verify:local": "node scripts/verify-migrations.mjs --local",
    "supabase:setup": "node scripts/supabase-setup.mjs",
    "import:sql": "tsx scripts/dump-to-supabase.ts",
    "seed": "tsx scripts/seed-web.ts",
    "lint": "eslint . && npm run typecheck:server && npm run typecheck:root",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supabase": "2.114.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
