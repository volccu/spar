# Web app (Vite). All vars MUST be prefixed VITE_ to reach the browser, and
# every one of them ends up in the bundle, so none of them is a secret.
# Copy this file to web/.env. All are optional: with none set, the app runs on
# this device only.
#
# From your Supabase project: Dashboard -> Project Settings -> API
#   - Project URL      -> VITE_SUPABASE_URL
#   - anon public key  -> VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The public half of your Web Push (VAPID) key pair, the same value as the
# send-reminders function's VAPID_PUBLIC_KEY secret. Without it reminders are
# still set and synced, but this build cannot ring and says so.
VITE_VAPID_PUBLIC_KEY=

# Set to 1 to read the backend from /config.json on the server this build is
# served from, instead of from the values above (which become its fallbacks).
# The Docker image is built this way; see docs/self-hosting.md. Leave it unset
# for a build with its backend baked in: that build never asks for the file.
VITE_RUNTIME_CONFIG=
